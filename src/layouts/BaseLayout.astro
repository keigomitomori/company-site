---
import '../styles/index.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { COMPANY_NAME, DEFAULT_OG_IMAGE, GA_MEASUREMENT_ID, SITE_NAME } from '../config/site';
import { breadcrumbJsonLd, type Crumb } from '../utils/jsonld';

interface Props {
  /**
   * ページ名（例: "会社概要"）。<title> は「<ページ名> | 株式会社ネクストブリッジ」、
   * og:title は「<ページ名> | NEXT Bridge」に自動で組み立てる。パンくずの末尾にも使う
   */
  title: string;
  description: string;
  /** <title> を丸ごと指定する（自動の組み立てと異なるページのみ。例: トップ） */
  fullTitle?: string;
  /** og:title を丸ごと指定する（自動の組み立てと異なるページのみ。例: トップ・記事） */
  ogTitle?: string;
  /** 省略時は description と同じ */
  ogDescription?: string;
  /**
   * 省略時はページの実URLから自動導出する。ルート直下の .html ページのみ明示する（CLAUDE.md の運用メモ）。
   * サイトルートからのパスで渡し、絶対URLは Astro.site から組み立てる
   */
  canonical?: string;
  ogType?: 'website' | 'article';
  /** サイトルートからのパス。省略時は既定の OG 画像 */
  ogImage?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  /** パンくず（BreadcrumbList）でホームと現在のページの間に入る階層 */
  breadcrumbParents?: Crumb[];
  /** false で BreadcrumbList を出力しない（トップページ用） */
  breadcrumb?: boolean;
  noindex?: boolean;
}
const {
  title,
  description,
  fullTitle = `${title} | ${COMPANY_NAME}`,
  ogTitle = `${title} | ${SITE_NAME}`,
  ogDescription = description,
  canonical: canonicalPath = Astro.url.pathname,
  ogType = 'website',
  ogImage: ogImagePath = DEFAULT_OG_IMAGE,
  articlePublishedTime,
  articleModifiedTime,
  breadcrumbParents = [],
  breadcrumb = true,
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site).href;
const ogImage = new URL(ogImagePath, Astro.site).href;
// Google tag は本番ビルドでのみ出力する（astro dev の閲覧を計測に混ぜない）
const gtagSnippet = `
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', '${GA_MEASUREMENT_ID}');
  `;
const breadcrumbData = breadcrumb
  ? breadcrumbJsonLd(Astro.site!, [...breadcrumbParents, { name: title }])
  : undefined;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {import.meta.env.PROD && (
    <Fragment>
      <!-- Google tag (gtag.js) -->
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
      {/* thanks.astro が gtag をグローバル関数として呼ぶため、IIFE で包む define:vars は使わない */}
      <script is:inline set:html={gtagSnippet} />
    </Fragment>
  )}
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#ffffff">
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content={ogType}>
  {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime}>}
  {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime}>}
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogTitle}>
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:locale" content="ja_JP">
  <!-- X は twitter:title / description / image を省略すると og:* を使う -->
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/images/favicon-48.png" type="image/png" sizes="48x48">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} コラム`} href="/rss.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- 本文: Noto Sans JP 400/500/700、見出し: Zen Maru Gothic 700（500 は未使用のため読み込まない） -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Maru+Gothic:wght@700&display=swap">
  <slot name="head" />
  {breadcrumbData && <JsonLd data={breadcrumbData} />}
</head>
<body>
  <a href="#main" class="skip-link">本文へスキップ</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
