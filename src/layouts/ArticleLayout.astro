---
import BaseLayout from './BaseLayout.astro';
import Cta from '../components/Cta.astro';
import JsonLd from '../components/JsonLd.astro';
import type { ArticleCategory } from '../data/articleCategories';
import { serviceForArticleCategory } from '../data/services';
import { fmt, iso } from '../utils/date';
import { articleJsonLd } from '../utils/jsonld';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  updatedDate?: Date;
  category: ArticleCategory;
}
const { title, description, slug, pubDate, updatedDate, category } = Astro.props;

// canonical は BaseLayout がページの実URL（/articles/<slug>/）から自動導出する
const ogImage = `/images/og/${slug}.png`;

// 記事末尾のCTAはカテゴリに合わせて出し分ける。カテゴリを追加して定義を漏らすと型エラーになる
const ctaByCategory: Record<ArticleCategory, { heading: string; text: string }> = {
  '生成AI統制': {
    heading: '生成AI統制の現状、一度整理してみませんか',
    text: '「何から手を付けるべきか」の整理からで構いません。現在の利用状況・環境をお聞きし、統制の全体像と優先順位をご提案します。初回相談は無料です。',
  },
  'デバイス管理': {
    heading: 'PC・デバイス管理の現状、一度整理してみませんか',
    text: '「何から手を付けるべきか」の整理からで構いません。現在の台数・環境をお聞きし、管理基盤づくりの全体像と優先順位をご提案します。初回相談は無料です。',
  },
  'セキュリティ': {
    heading: 'セキュリティ対策の現状、一度整理してみませんか',
    text: '「何から手を付けるべきか」の整理からで構いません。現在の環境と体制をお聞きし、対策の全体像と優先順位をご提案します。初回相談は無料です。',
  },
  '情シス運営': {
    heading: '社内ITの困りごと、一度整理してみませんか',
    text: '「何から手を付けるべきか」の整理からで構いません。現在の運用状況をお聞きし、改善の全体像と優先順位をご提案します。初回相談は無料です。',
  },
};
const cta = ctaByCategory[category];
// カテゴリに対応する LP（src/data/services.ts の articleCategory）があれば、相談に加えて LP への導線を出す
const relatedService = serviceForArticleCategory(category);

const articleData = articleJsonLd(Astro.site!, {
  title,
  description,
  path: Astro.url.pathname,
  image: ogImage,
  datePublished: iso(pubDate),
  dateModified: iso(updatedDate ?? pubDate),
});
---
<BaseLayout
  title={title}
  description={description}
  ogTitle={title}
  ogType="article"
  ogImage={ogImage}
  articlePublishedTime={iso(pubDate)}
  articleModifiedTime={iso(updatedDate ?? pubDate)}
  breadcrumbParents={[{ name: 'コラム', path: '/articles/' }]}
>
  <JsonLd slot="head" data={articleData} />

  <article class="article">
    <header class="article-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="パンくず">
          <a href="/">ホーム</a><span>/</span><a href="/articles/">コラム</a><span>/</span><span aria-current="page">{title}</span>
        </nav>
        <span class="article-category">{category}</span>
        <h1>{title}</h1>
        <p class="article-meta">
          <time datetime={iso(pubDate)}>{fmt(pubDate)} 公開</time>
          {updatedDate && <time datetime={iso(updatedDate)}>（{fmt(updatedDate)} 更新）</time>}
          <span class="article-author-line">執筆: 株式会社ネクストブリッジ</span>
        </p>
      </div>
    </header>

    <div class="container article-column">
      <img class="article-eyecatch" src={`/images/og/${slug}.png`} alt="" width="1200" height="630">
      <div class="article-body">
        <slot />
      </div>

      <aside class="author-box">
        <p class="author-box-title">執筆者</p>
        <p class="author-box-name">株式会社ネクストブリッジ</p>
        <p class="author-box-bio">中堅・中小企業のIT顧問、Microsoft 365 / Entra ID / Intune の導入、ISMS運用、生成AI（Claude・Claude Code）の企業導入と統制設計を実務で支援しています。</p>
      </aside>
    </div>
  </article>

  <Cta
    heading={cta.heading}
    text={cta.text}
    buttonClass="btn btn-primary"
    buttonLabel="相談してみる"
    secondary={relatedService && { href: relatedService.href, label: `${relatedService.shortTitle}のご案内` }}
  />
</BaseLayout>

<style>
  /* 見出し・アイキャッチ・本文・執筆者を 760px の1カラムにそろえる */
  .article-header .container,
  .article-column {
    max-width: calc(760px + var(--gutter) * 2);
  }

  .article-header {
    background-color: var(--bg-page);
    padding: var(--space-14) 0 var(--space-10);
  }

  .breadcrumb {
    font-size: var(--fs-caption);
    color: var(--muted);
    margin-bottom: var(--space-6);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .breadcrumb a:hover {
    color: var(--accent-strong);
  }

  .article-category {
    margin-bottom: var(--space-4);
  }

  .article-header h1 {
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.55;
  }

  .article-meta {
    margin-top: var(--space-4);
    font-size: var(--fs-caption);
    color: var(--muted);
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .article-eyecatch {
    width: 100%;
    height: auto;
    margin-top: var(--space-10);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .article-body {
    padding: var(--space-10) 0 var(--space-2);
  }

  /* 本文は Markdown から描画されるため :global() で当てる */
  .article-body :global(h2) {
    font-size: 24px;
    line-height: 1.55;
    margin: var(--space-14) 0 var(--space-5);
    padding-left: var(--space-4);
    border-left: 4px solid var(--accent);
  }

  .article-body :global(h3) {
    font-size: 19px;
    line-height: 1.6;
    margin: var(--space-10) 0 var(--space-3);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-5);
    line-height: 1.95;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 var(--space-5);
    padding-left: 1.5em;
  }

  .article-body :global(ul) {
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(li) {
    padding: 3px 0;
  }

  .article-body :global(li::marker) {
    color: var(--accent);
  }

  .article-body :global(a) {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-body :global(strong) {
    font-weight: 700;
    color: var(--ink);
  }

  .article-body :global(code) {
    font-size: 0.9em;
    background-color: var(--bg-page);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }

  .article-body :global(pre) {
    margin: 0 0 var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: var(--fs-small);
    line-height: 1.7;
  }

  .article-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .author-box {
    margin: var(--space-10) 0 var(--space-18);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
    background-color: var(--bg-page);
  }

  .author-box-title {
    font-size: var(--fs-caption);
    font-weight: 700;
    color: var(--accent-strong);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }

  .author-box-name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-1);
  }

  .author-box-bio {
    font-size: var(--fs-small);
    color: var(--text-sub);
  }

  @media (max-width: 768px) {
    .article-header {
      padding: var(--space-8) 0;
    }

    .article-eyecatch {
      margin-top: var(--space-6);
    }

    .article-body :global(h2) {
      font-size: 21px;
      margin-top: var(--space-10);
    }

    .author-box {
      padding: var(--space-5);
      margin-bottom: var(--space-14);
    }
  }
</style>
