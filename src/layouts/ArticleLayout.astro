---
import BaseLayout from './BaseLayout.astro';
import Cta from '../components/Cta.astro';
import { fmt, iso } from '../utils/date';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
}
const { title, description, slug, pubDate, updatedDate, category } = Astro.props;

const canonical = `https://nextb.net/articles/${slug}/`;
const ogImage = `https://nextb.net/images/og/${slug}.png`;

// 記事末尾のCTAはカテゴリに合わせて出し分ける（未定義カテゴリは汎用文言）
const ctaByCategory: Record<string, { heading: string; text: string }> = {
  '生成AI統制': {
    heading: '生成AI統制の現状、一度整理してみませんか',
    text: '「何から手を付けるべきか」の整理からで構いません。現在の利用状況・環境をお聞きし、統制の全体像と優先順位をご提案します。初回相談は無料です。',
  },
  'デバイス管理': {
    heading: 'PC・デバイス管理の現状、一度整理してみませんか',
    text: '「何から手を付けるべきか」の整理からで構いません。現在の台数・環境をお聞きし、管理基盤づくりの全体像と優先順位をご提案します。初回相談は無料です。',
  },
  'セキュリティ': {
    heading: 'セキュリティ対策の現状、一度整理してみませんか',
    text: '「何から手を付けるべきか」の整理からで構いません。現在の環境と体制をお聞きし、対策の全体像と優先順位をご提案します。初回相談は無料です。',
  },
  '情シス運営': {
    heading: '社内ITの困りごと、一度整理してみませんか',
    text: '「何から手を付けるべきか」の整理からで構いません。現在の運用状況をお聞きし、改善の全体像と優先順位をご提案します。初回相談は無料です。',
  },
};
const cta = ctaByCategory[category] ?? {
  heading: '社内ITの困りごと、一度整理してみませんか',
  text: '「何から手を付けるべきか」の整理からで構いません。現在の状況をお聞きし、改善の全体像と優先順位をご提案します。初回相談は無料です。',
};

const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://nextb.net/' },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: 'https://nextb.net/articles/' },
    { '@type': 'ListItem', position: 3, name: title },
  ],
});

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: [ogImage],
  datePublished: iso(pubDate),
  dateModified: iso(updatedDate ?? pubDate),
  author: { '@type': 'Organization', name: '株式会社ネクストブリッジ', url: 'https://nextb.net/' },
  publisher: { '@type': 'Organization', name: '株式会社ネクストブリッジ', url: 'https://nextb.net/' },
  mainEntityOfPage: canonical,
});
---
<BaseLayout
  title={`${title} | 株式会社ネクストブリッジ`}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  ogImage={ogImage}
  articlePublishedTime={iso(pubDate)}
  articleModifiedTime={iso(updatedDate ?? pubDate)}
  twitterImage={ogImage}
>
  <script type="application/ld+json" set:html={jsonLd} />
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />

  <article class="article">
    <header class="article-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="パンくず">
          <a href="/">ホーム</a><span>/</span><a href="/articles/">コラム</a><span>/</span><span aria-current="page">{title}</span>
        </nav>
        <span class="article-category">{category}</span>
        <h1>{title}</h1>
        <p class="article-meta">
          <time datetime={iso(pubDate)}>{fmt(pubDate)} 公開</time>
          {updatedDate && <time datetime={iso(updatedDate)}>（{fmt(updatedDate)} 更新）</time>}
          <span class="article-author-line">執筆: 株式会社ネクストブリッジ</span>
        </p>
      </div>
    </header>

    <div class="container">
      <img class="article-eyecatch" src={`/images/og/${slug}.png`} alt="" width="1200" height="630">
      <div class="article-body">
        <slot />
      </div>

      <aside class="author-box">
        <p class="author-box-title">執筆者</p>
        <p class="author-box-name">株式会社ネクストブリッジ</p>
        <p class="author-box-bio">中堅・中小企業のIT顧問、Microsoft 365 / Entra ID / Intune の導入、ISMS運用、生成AI（Claude・Claude Code）の企業導入と統制設計を実務で支援しています。</p>
      </aside>
    </div>
  </article>

  <Cta
    heading={cta.heading}
    text={cta.text}
    buttonClass="btn btn-primary"
    buttonLabel="相談してみる"
  />
</BaseLayout>
