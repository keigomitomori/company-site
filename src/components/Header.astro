---
const navItems = [
  { href: '/', label: 'ホーム' },
  { href: '/about.html', label: '会社概要' },
  { href: '/services.html', label: 'サービス' },
  { href: '/pricing.html', label: '料金' },
  { href: '/articles/', label: 'コラム' },
  { href: '/contact.html', label: 'お問い合わせ', className: 'nav-contact' },
];

// 現在のページに aria-current="page" を付ける（/articles/index.html のような表記も同一視する）
const normalize = (path: string) => path.replace(/index\.html$/, '');
const currentPath = normalize(Astro.url.pathname);
---
<header class="header">
  <div class="container">
    <div class="logo">
      <a href="/">
        <img src="/images/logo.webp" alt="NEXT Bridge" width="1117" height="185">
      </a>
    </div>
    <button type="button" class="menu-icon" aria-expanded="false" aria-controls="site-nav" aria-label="メニューを開く"><span></span></button>
    <div class="nav-overlay" aria-hidden="true"></div>
    <nav class="nav" id="site-nav">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li><a href={item.href} class={item.className} aria-current={normalize(item.href) === currentPath ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <noscript>
    <style>
      /* JS無効時はハンバーガーを隠し、モバイルでもナビを静的に展開する */
      .menu-icon { display: none !important; }
      @media (max-width: 768px) {
        .header .container { flex-wrap: wrap; height: auto; padding-top: 10px; padding-bottom: 10px; }
        .nav {
          position: static;
          visibility: visible;
          transform: none;
          width: 100%;
          max-width: none;
          height: auto;
          overflow: visible;
          box-shadow: none;
          padding: 0;
          transition: none;
        }
      }
    </style>
  </noscript>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('.header');
    var btn = header && header.querySelector('.menu-icon');
    var overlay = header && header.querySelector('.nav-overlay');
    var nav = header && header.querySelector('.nav');
    if (!header || !btn || !overlay || !nav) return;
    var root = document.documentElement;
    var mobile = window.matchMedia('(max-width: 768px)');
    function isOpen() {
      return btn.getAttribute('aria-expanded') === 'true';
    }
    function focusables() {
      return [btn].concat(Array.prototype.slice.call(nav.querySelectorAll('a[href]')));
    }
    function setOpen(open) {
      header.classList.toggle('nav-open', open);
      root.classList.toggle('is-nav-locked', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      // 開いたらメニュー内の先頭リンクへフォーカスを移す
      if (open) {
        var first = nav.querySelector('a[href]');
        if (first) first.focus();
      }
    }
    btn.addEventListener('click', function () {
      setOpen(!isOpen());
    });
    overlay.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        setOpen(false);
        btn.focus();
        return;
      }
      // 開いている間はメニューとボタンの中でフォーカスを循環させる
      if (e.key === 'Tab') {
        var items = focusables();
        var first = items[0];
        var last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        } else if (items.indexOf(document.activeElement) === -1) {
          e.preventDefault();
          first.focus();
        }
      }
    });
    // PC幅に戻ったら開いた状態を解除する（スクロール固定が残らないように）
    function onChange(e) {
      if (!e.matches && isOpen()) setOpen(false);
    }
    if (mobile.addEventListener) mobile.addEventListener('change', onChange);
  })();
</script>
