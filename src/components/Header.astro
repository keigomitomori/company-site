<header class="header">
  <div class="container">
    <div class="logo">
      <a href="/">
        <img src="/images/logo.webp" alt="NEXT Bridge" width="1117" height="185">
      </a>
    </div>
    <button type="button" class="menu-icon" aria-expanded="false" aria-controls="site-nav" aria-label="メニューを開く"><span></span></button>
    <div class="nav-overlay" aria-hidden="true"></div>
    <nav class="nav" id="site-nav">
      <ul class="nav-list">
        <li><a href="/">ホーム</a></li>
        <li><a href="/about.html">会社概要</a></li>
        <li><a href="/services.html">サービス</a></li>
        <li><a href="/pricing.html">料金</a></li>
        <li><a href="/articles/">コラム</a></li>
        <li><a href="/contact.html" class="nav-contact">お問い合わせ</a></li>
      </ul>
    </nav>
  </div>
  <noscript>
    <style>
      /* JS無効時はハンバーガーを隠し、モバイルでもナビを静的に展開する */
      .menu-icon { display: none !important; }
      @media (max-width: 768px) {
        .header .container { flex-wrap: wrap; height: auto; padding-top: 10px; padding-bottom: 10px; }
        .nav {
          position: static;
          visibility: visible;
          width: 100%;
          max-width: none;
          height: auto;
          box-shadow: none;
          padding: 0;
          transition: none;
        }
      }
    </style>
  </noscript>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('.header');
    var btn = header && header.querySelector('.menu-icon');
    var overlay = header && header.querySelector('.nav-overlay');
    if (!header || !btn || !overlay) return;
    function setOpen(open) {
      header.classList.toggle('nav-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    }
    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });
    overlay.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
  })();
</script>
