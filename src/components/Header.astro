---
import { isServicePath, serviceGroupsWithServices } from '../data/services';

// 「サービス」はグループ別の LP を並べたメニューを開く（項目は src/data/services.ts から導出）。
// JS 無効時は /services/ への通常のリンクとして働く
const navItems = [
  { href: '/cases/', label: '支援事例' },
  { href: '/pricing/', label: '料金' },
  { href: '/articles/', label: 'コラム' },
  { href: '/about/', label: '会社概要' },
  { href: '/contact/', label: 'お問い合わせ', className: 'nav-contact' },
];
const groups = serviceGroupsWithServices();

// 現在のページに aria-current="page" を付ける（/articles/index.html のような表記も同一視する）
const normalize = (path: string) => path.replace(/index\.html$/, '');
const currentPath = normalize(Astro.url.pathname);
const current = (href: string) => (normalize(href) === currentPath ? 'page' : undefined);
// サービス一覧・LP にいるときは「サービス」を現在地として見た目で示す（aria-current は実際のページのリンクにだけ付ける）
const inServices = isServicePath(currentPath);
---
<header class="header">
  <div class="container">
    <div class="logo">
      <a href="/">
        <img src="/images/logo.webp" alt="NEXT Bridge" width="1117" height="185">
      </a>
    </div>
    <button type="button" class="menu-icon" aria-expanded="false" aria-controls="site-nav" aria-label="メニューを開く"><span></span></button>
    <div class="nav-overlay" aria-hidden="true"></div>
    <nav class="nav" id="site-nav" aria-label="メインメニュー">
      <ul class="nav-list">
        <li class="nav-services">
          <a href="/services/" class:list={['nav-services-link', { 'is-current-section': inServices }]} aria-current={current('/services/')}>サービス</a>
          <button type="button" class:list={['nav-services-toggle', { 'is-current-section': inServices }]} aria-expanded="false" aria-controls="nav-services-panel">サービス</button>
          <div class="nav-panel" id="nav-services-panel">
            <div class="nav-panel-groups">
              {groups.map(({ group, services }) => (
                <div class="nav-group">
                  <p class="nav-group-label" id={`nav-group-${group.id}`}>{group.name}</p>
                  <ul aria-labelledby={`nav-group-${group.id}`}>
                    {services.map((service) => (
                      <li><a href={service.href} aria-current={current(service.href)}>{service.title}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <a href="/services/" class="nav-panel-all" aria-current={current('/services/')}>サービス一覧 →</a>
          </div>
        </li>
        {navItems.map((item) => (
          <li><a href={item.href} class={item.className} aria-current={current(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <noscript>
    <style>
      /* JS無効時はハンバーガーを隠し、モバイルでもナビを静的に展開する */
      .menu-icon { display: none !important; }
      @media (max-width: 768px) {
        .header .container { flex-wrap: wrap; height: auto; padding-top: 10px; padding-bottom: 10px; }
        .nav {
          position: static;
          visibility: visible;
          transform: none;
          width: 100%;
          max-width: none;
          height: auto;
          overflow: visible;
          box-shadow: none;
          padding: 0;
          transition: none;
        }
      }
    </style>
  </noscript>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('.header');
    var btn = header && header.querySelector('.menu-icon');
    var overlay = header && header.querySelector('.nav-overlay');
    var nav = header && header.querySelector('.nav');
    if (!header || !btn || !overlay || !nav) return;
    var root = document.documentElement;
    var mobile = window.matchMedia('(max-width: 768px)');

    // ---------- サービスのメニュー（PC幅のディスクロージャー） ----------
    // JS が動くときだけボタンに切り替える（.has-js が無ければ「サービス」は /services/ へのリンク）
    header.classList.add('has-js');
    var services = header.querySelector('.nav-services');
    var toggle = services && services.querySelector('.nav-services-toggle');
    function isPanelOpen() {
      return !!toggle && toggle.getAttribute('aria-expanded') === 'true';
    }
    function setPanel(open) {
      if (!toggle) return;
      toggle.setAttribute('aria-expanded', String(open));
    }
    if (toggle) {
      toggle.addEventListener('click', function () {
        setPanel(!isPanelOpen());
      });
      // メニューの外をクリックしたら閉じる
      document.addEventListener('click', function (e) {
        if (isPanelOpen() && !services.contains(e.target)) setPanel(false);
      });
      // フォーカスがメニューの外へ出たら閉じる（Tab で次の項目へ進んだとき）
      services.addEventListener('focusout', function (e) {
        if (isPanelOpen() && e.relatedTarget && !services.contains(e.relatedTarget)) setPanel(false);
      });
    }

    // ---------- モバイルのメニュー（ドロワー） ----------
    function isOpen() {
      return btn.getAttribute('aria-expanded') === 'true';
    }
    // 表示されているリンクだけを対象にする（モバイルでは PC 用のボタン・一覧リンクが非表示）
    function focusables() {
      var links = Array.prototype.slice.call(nav.querySelectorAll('a[href], button'));
      return [btn].concat(links.filter(function (el) { return el.getClientRects().length > 0; }));
    }
    function setOpen(open) {
      header.classList.toggle('nav-open', open);
      root.classList.toggle('is-nav-locked', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      // 開いたらメニュー内の先頭リンクへフォーカスを移す
      if (open) {
        var first = focusables()[1];
        if (first) first.focus();
      }
    }
    btn.addEventListener('click', function () {
      setOpen(!isOpen());
    });
    overlay.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) {
      // PC幅: サービスのメニューを Esc で閉じ、ボタンへフォーカスを戻す
      if (e.key === 'Escape' && isPanelOpen()) {
        setPanel(false);
        toggle.focus();
        return;
      }
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        setOpen(false);
        btn.focus();
        return;
      }
      // 開いている間はメニューとボタンの中でフォーカスを循環させる
      if (e.key === 'Tab') {
        var items = focusables();
        var first = items[0];
        var last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        } else if (items.indexOf(document.activeElement) === -1) {
          e.preventDefault();
          first.focus();
        }
      }
    });
    // 幅が切り替わったら開いた状態を解除する（スクロール固定やメニューの開きが残らないように）
    function onChange(e) {
      if (!e.matches && isOpen()) setOpen(false);
      if (e.matches && isPanelOpen()) setPanel(false);
    }
    if (mobile.addEventListener) mobile.addEventListener('change', onChange);
  })();
</script>
