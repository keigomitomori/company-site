---
import type { Service } from '../data/services';

interface Props {
  service: Service;
  /** 横長のカード（グループに1サービスだけのとき） */
  wide?: boolean;
}
const { service, wide = false } = Astro.props;
---
<a href={service.href} class:list={['card', 'card--link', { 'card--wide': wide }]}>
  <div class="card-illust">
    <img src={service.image.src} alt="" loading="lazy" width={service.image.width} height={service.image.height}>
  </div>
  <div class="card-body">
    <h4>{service.title}</h4>
    <p>{service.description}</p>
    <span class="card-more">詳しく見る →</span>
  </div>
</a>

<style>
  /* 白い地のセクションに置かれるため、ごく淡い線を添える */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .card--link {
    transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
  }

  .card--link:hover {
    border-color: var(--accent-soft);
    box-shadow: var(--shadow-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card--link:hover {
      transform: translateY(-2px);
    }
  }

  .card-illust {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .card-illust img {
    max-height: 100%;
    width: auto;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* グループ見出し（h3）の下に置くため h4。見た目は既存のカード見出しのまま */
  .card-body h4 {
    font-family: var(--font-display);
    color: var(--ink);
    font-size: 21px;
    line-height: 1.5;
    margin-bottom: var(--space-2);
    word-break: auto-phrase;
    text-wrap: pretty;
  }

  .card-body p {
    color: var(--muted);
  }

  .card-more {
    margin-top: auto;
    padding-top: var(--space-4);
    font-weight: 700;
    color: var(--accent);
  }

  .card--link:hover .card-more {
    color: var(--accent-strong);
  }

  /* 横長: イラストを左、文章を右に置く */
  .card--wide {
    height: auto;
    flex-direction: row;
    align-items: center;
    gap: var(--space-10);
    padding: var(--space-8) var(--space-10);
  }

  .card--wide .card-illust {
    flex: 0 0 200px;
    margin-bottom: 0;
  }

  .card--wide .card-body h4 {
    font-size: 24px;
  }

  @media (max-width: 768px) {
    .card {
      padding: var(--space-6);
    }

    .card-illust {
      height: 130px;
      margin-bottom: var(--space-5);
    }

    .card-body h4 {
      font-size: 19px;
    }

    .card--wide {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-6);
    }

    .card--wide .card-illust {
      flex: none;
      margin-bottom: var(--space-5);
    }

    .card--wide .card-body h4 {
      font-size: 19px;
    }
  }
</style>
