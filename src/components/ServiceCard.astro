---
import type { ServiceCardData } from '../data/services';

interface Props {
  service: ServiceCardData;
}
const { service } = Astro.props;
---
<a href={service.href} class="card card--link">
  <div class="card-illust">
    <img src={service.image.src} alt="" loading="lazy" width={service.image.width} height={service.image.height}>
  </div>
  <div class="card-body">
    <h3>{service.title}</h3>
    <p>{service.description}</p>
    <span class="card-more">詳しく見る →</span>
  </div>
</a>

<style>
  /* 白い地のセクションに置かれるため、ごく淡い線を添える */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .card--link {
    transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
  }

  .card--link:hover {
    border-color: var(--accent-soft);
    box-shadow: var(--shadow-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card--link:hover {
      transform: translateY(-2px);
    }
  }

  .card-illust {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .card-illust img {
    max-height: 100%;
    width: auto;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-body h3 {
    font-size: 21px;
    line-height: 1.5;
    margin-bottom: var(--space-2);
  }

  .card-body p {
    color: var(--muted);
  }

  .card-more {
    margin-top: auto;
    padding-top: var(--space-4);
    font-weight: 700;
    color: var(--accent);
  }

  .card--link:hover .card-more {
    color: var(--accent-strong);
  }

  @media (max-width: 768px) {
    .card {
      padding: var(--space-6);
    }

    .card-illust {
      height: 130px;
      margin-bottom: var(--space-5);
    }

    .card-body h3 {
      font-size: 19px;
    }
  }
</style>
