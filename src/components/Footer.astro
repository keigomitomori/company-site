---
import { serviceGroupsWithServices } from '../data/services';
import { tokyoYear } from '../utils/date';

// 著作権表示の年はビルド時点（日本時間）の年にする
const year = tokyoYear();
// サービスの列はグループ別に src/data/services.ts の順で並べる
const groups = serviceGroupsWithServices();
---
<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-company">
        <div class="footer-logo">NEXT Bridge</div>
        <address class="footer-address"><p>〒104-0061<br>東京都中央区銀座1-12-4<br>N&amp;E BLD.7階</p></address>
      </div>
      <nav class="footer-nav" aria-label="サービス">
        <h2 class="footer-heading">サービス</h2>
        <ul>
          <li><a href="/services/">サービス一覧</a></li>
        </ul>
        {groups.map(({ group, services }) => (
          <div class="footer-group">
            <p class="footer-group-label" id={`footer-group-${group.id}`}>{group.name}</p>
            <ul aria-labelledby={`footer-group-${group.id}`}>
              {services.map((service) => (
                <li><a href={service.href}>{service.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <nav class="footer-nav" aria-label="メニュー">
        <h2 class="footer-heading">メニュー</h2>
        <ul>
          <li><a href="/">ホーム</a></li>
          <li><a href="/cases/">支援事例</a></li>
          <li><a href="/pricing/">料金</a></li>
          <li><a href="/articles/">コラム</a></li>
          <li><a href="/about/">会社概要</a></li>
          <li><a href="/contact/">お問い合わせ</a></li>
          <li><a href="/privacy/">プライバシーポリシー</a></li>
        </ul>
      </nav>
      <div class="footer-contact">
        <h2 class="footer-heading">お問い合わせ</h2>
        <p>Mail: <a href="mailto:contact@nextb.net">contact@nextb.net</a></p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} NEXT Bridge All Rights Reserved.</p>
    </div>
  </div>
</footer>
