---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Cta from '../components/Cta.astro';
import CaseCard from '../components/CaseCard.astro';
import { itStartupCase, deviceManagementCase, genaiAdoptionCase } from '../data/cases';
import LpBanner from '../components/LpBanner.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/services';
---
<BaseLayout
  title="サービス | 株式会社ネクストブリッジ"
  description="NEXT Bridgeのサービス紹介ページです。情シスコンサルティング・製品導入支援・生成AI導入支援をご提供しています。"
  canonical="https://nextb.net/services.html"
  ogTitle="サービス | NEXT Bridge"
  ogDescription="情シスコンサルティング・製品導入支援・生成AI導入支援をご提供しています。"
>
  <PageHeader title="サービス" subtitle="Services" />

  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>サービス詳細</h2>
        <p>Service Details</p>
      </div>

      <div class="card-grid card-grid--lp">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="section section-gray" id="cases">
    <div class="container">
      <div class="section-title">
        <h2>支援事例</h2>
        <p>Cases</p>
      </div>
      <div class="case-grid">
        <CaseCard data={itStartupCase.full} />
        <CaseCard data={deviceManagementCase.full} />
        <CaseCard data={genaiAdoptionCase.full} />
      </div>
    </div>
  </section>

  <section class="section" id="flow">
    <div class="container">
      <div class="section-title">
        <h2>支援の流れ</h2>
        <p>Flow</p>
      </div>
      <ol class="flow-steps">
        <li class="flow-step">
          <div class="flow-step-number">1</div>
          <div class="flow-step-body">
            <h3>お問い合わせ</h3>
            <p>フォームよりご連絡ください。折り返し、初回相談の日程をご案内します。</p>
          </div>
        </li>
        <li class="flow-step">
          <div class="flow-step-number">2</div>
          <div class="flow-step-body">
            <h3>初回相談</h3>
            <p>オンラインで現状の困りごとやご要望をお伺いします。まずは状況の整理からで構いません。</p>
          </div>
        </li>
        <li class="flow-step">
          <div class="flow-step-number">3</div>
          <div class="flow-step-body">
            <h3>ご提案・お見積もり</h3>
            <p>お伺いした内容をもとに、支援範囲・進め方・お見積もりをご提案します。</p>
          </div>
        </li>
        <li class="flow-step">
          <div class="flow-step-number">4</div>
          <div class="flow-step-body">
            <h3>ご契約・支援開始</h3>
            <p>内容にご納得いただけましたら契約を締結し、ご支援を開始します。</p>
          </div>
        </li>
      </ol>
      <div class="contract-grid">
        <div class="contract-card">
          <h3>顧問契約</h3>
          <p>月次の定例と随時のご相談で、情シス業務に継続的に伴走します。長期のお付き合いを前提とした形です。</p>
        </div>
        <div class="contract-card">
          <h3>プロジェクト型支援</h3>
          <p>製品導入や生成AI活用の立ち上げなど、期間と支援範囲を定めてご支援します。</p>
        </div>
      </div>
      <p class="contract-note">いずれのご契約も準委任です。詳しくは料金ページの注記をご覧ください。</p>

      <LpBanner text="それぞれの料金の目安は料金ページでご案内しています" href="/pricing.html" label="料金" />
    </div>
  </section>

  <Cta
    heading="サービスに関するご相談はこちら"
    text="支援範囲と進め方は、状況を伺ったうえでご提案します。初回相談とお見積もりは無料です。"
  />
</BaseLayout>

<style>
  /* ========== 支援の流れ ========== */
  .flow-steps,
  .contract-grid,
  .contract-note {
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
  }

  .flow-step {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--line);
  }

  .flow-step:last-child {
    border-bottom: none;
  }

  .flow-step-number {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flow-step-body h3 {
    font-size: 20px;
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }

  .flow-step-body p {
    color: var(--text-sub);
  }

  /* ========== 契約形態 ========== */
  .contract-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  /* 白い地に置くカードのため、ごく淡い線を添える */
  .contract-card {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .contract-card h3 {
    font-size: 20px;
    margin-bottom: var(--space-2);
  }

  .contract-card p {
    color: var(--text-sub);
    font-size: 15px;
  }

  .contract-note {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--fs-small);
  }

  @media (max-width: 768px) {
    .flow-step {
      gap: var(--space-4);
      padding: var(--space-5) 0;
    }

    .flow-step-number {
      flex-basis: 40px;
      width: 40px;
      height: 40px;
      font-size: 16px;
    }

    .contract-grid {
      grid-template-columns: 1fr;
    }

    .contract-card {
      padding: var(--space-5) var(--space-6);
    }
  }
</style>
