---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Cta from '../components/Cta.astro';
import LpBanner from '../components/LpBanner.astro';
import ServiceGroups from '../components/ServiceGroups.astro';
import { getService, type ServiceSlug } from '../data/services';

// 比較表。セルに書いてよいのは各 LP（ヒーロー・お悩み・特長・中間CTA・FAQ）に既にある事実だけ。
// 費用の目安は各 LP の中間CTAの注記と同じレンジにする（料金の決定は CLAUDE.md の運用メモが正本）
const compareRows: { slug: ServiceSlug; situation: string; scope: string; contract: string[]; cost: string[] }[] = [
  {
    slug: 'it-support',
    situation: '専任の情シスがいない、または一人で手が回っていない',
    scope: 'PC・アカウントの管理、セキュリティ整備、SaaSの運用、社員からの相談対応',
    contract: ['顧問契約'],
    cost: ['顧問契約 月10万円〜（税別）'],
  },
  {
    slug: 'device-management',
    situation: '新しいPCのセットアップが毎回手作業で、セキュリティ設定が端末ごとにバラバラ',
    scope: 'Intune / Entra ID による管理基盤の設計・構築、キッティングの自動化、運用の引き継ぎ',
    contract: ['プロジェクト型支援'],
    cost: ['プロジェクト型支援 30万円〜（税別）'],
  },
  {
    slug: 'scs',
    situation: 'SCS評価制度が自社に関係するのか、何から手を付けるべきか判断できない',
    scope: '★3・★4の要求事項と現状のギャップ分析、規程・台帳・設定の整備、評価への準備',
    contract: ['プロジェクト型支援', '顧問契約'],
    cost: ['プロジェクト型支援 30万円〜（税別）', '顧問契約 月10万円〜（税別）'],
  },
  {
    slug: 'genai-adoption',
    situation: '生成AIをどの業務に使えるか分からず、一部の社員の試行にとどまっている',
    scope: '業務の棚卸し、ユースケース設計、試作、現場評価、全社展開',
    contract: ['プロジェクト型支援'],
    cost: ['プロジェクト型支援 30万円〜（税別）'],
  },
  {
    slug: 'genai-governance',
    situation: '社員が生成AIを個人アカウントで使い始めていて、Claude Code の設定や権限も管理しきれない',
    scope: '利用ガイドライン策定、SSO・アカウント統制、managed settings の設計、Intune / MDM での配布、ISMSとの整合',
    contract: ['プロジェクト型支援', '顧問契約'],
    cost: ['プロジェクト型支援 30万円〜（税別）', '顧問契約 月10万円〜（税別）'],
  },
];
---
<BaseLayout
  title="サービス"
  description="NEXT Bridgeのサービス一覧です。情シス業務／PC・セキュリティ／生成AIの3分野で、各サービスの対象となる状況・支援内容・ご契約の形・費用の目安を比較できます。"
  ogDescription="情シス業務／PC・セキュリティ／生成AIの3分野のサービスと、支援内容・費用の目安の比較です。"
>
  <PageHeader title="サービス" subtitle="Services" />

  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>分野別のサービス</h2>
        <p>Services</p>
      </div>
      <p class="services-lead">ご相談の内容から、3つの分野でお選びいただけます。各サービスの違いは<a href="#compare">サービスの比較</a>でご確認いただけます。</p>
      <ServiceGroups />
    </div>
  </section>

  <section class="section section-gray" id="compare">
    <div class="container">
      <div class="section-title">
        <h2 id="compare-heading">サービスの比較</h2>
        <p>Compare</p>
      </div>
      <p class="compare-scroll-hint">表は横にスクロールしてご覧いただけます。</p>
      <div class="price-table-wrap price-table-wrap--wide" role="region" aria-labelledby="compare-heading" tabindex="0">
        <table class="price-table price-table--compare">
          <thead>
            <tr>
              <th scope="col">サービス</th>
              <th scope="col">こんな状況の企業に</th>
              <th scope="col">主な支援内容</th>
              <th scope="col">ご契約の形</th>
              <th scope="col">費用の目安</th>
            </tr>
          </thead>
          <tbody>
            {compareRows.map((row) => {
              const service = getService(row.slug);
              return (
                <tr>
                  <th scope="row"><a href={service.href}>{service.title}</a></th>
                  <td>{row.situation}</td>
                  <td>{row.scope}</td>
                  <td>{row.contract.map((c) => <span class="compare-line">{c}</span>)}</td>
                  <td>{row.cost.map((c) => <span class="compare-line">{c}</span>)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <ul class="price-notes">
        <li>※ 費用は目安で、支援範囲により変わります。SCS評価制度対応支援の金額は当社の支援費用で、申請・専門家確認・第三者評価など制度側の費用は含みません。</li>
        <li>※ ご契約はいずれも準委任です。契約形態の違いは料金ページの<a href="/pricing/#contract">ご契約形態</a>、ご相談からの進め方は<a href="/pricing/#flow">ご相談から契約までの流れ</a>をご覧ください。</li>
      </ul>
      <LpBanner text="これまでの支援事例は、分野ごとにまとめてご覧いただけます" href="/cases/" label="支援事例" />
    </div>
  </section>

  <Cta
    heading="サービスに関するご相談はこちら"
    text="支援範囲と進め方は、状況を伺ったうえでご提案します。初回相談とお見積もりは無料です。"
  />
</BaseLayout>

<style>
  .services-lead {
    max-width: 760px;
    margin: calc(var(--space-8) * -1) auto var(--space-10);
    text-align: center;
    color: var(--text-sub);
  }

  .services-lead a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* 契約の形が2つあるサービスは、形ごとに1行ずつ並べる */
  .compare-line {
    display: block;
  }

  .compare-line + .compare-line {
    margin-top: var(--space-1);
  }

  /* 狭い画面では表が枠内で横スクロールになるため、その旨を添える */
  .compare-scroll-hint {
    display: none;
  }

  @media (max-width: 768px) {
    .compare-scroll-hint {
      display: block;
      margin-bottom: var(--space-2);
      font-size: var(--fs-small);
      color: var(--muted);
    }

    .services-lead {
      margin-top: calc(var(--space-5) * -1);
      text-align: left;
    }
  }
</style>
