---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import CaseCard from '../../components/CaseCard.astro';
import { itStartupCase } from '../../data/cases';
import LpSteps from '../../components/LpSteps.astro';
import { ill } from '../../data/illustrations';
import LpFaq from '../../components/LpFaq.astro';
import LpBanner from '../../components/LpBanner.astro';
import LpConsult from '../../components/LpConsult.astro';

const steps = [
  { image: ill.magnifier, title: "無料相談", items: ["いまの困りごとを棚卸し", "IT環境の現状を確認"] },
  { image: ill.document, title: "ご提案・お見積もり", items: ["支援範囲のすり合わせ", "月額と進め方のご提案"] },
  { image: ill.shieldpc, title: "支援開始", items: ["相談窓口の開設", "優先度の高い課題から着手"] },
  { image: ill.growth, title: "定例で改善", items: ["定例ミーティングで見直し", "成長に合わせて範囲を調整"] },
];

const faqItems = [
  { q: "何名くらいの規模が対象ですか？", a: "10名前後の立ち上げ期から100名を超える規模まで支援しています。専任の情シスがいない、または一人で手が回っていない会社が中心です。" },
  { q: "訪問はしてもらえますか？", a: "基本はリモートで、機器の入れ替えなど必要な場面では訪問も組み合わせます。" },
  { q: "どこまでお願いできますか？", a: "ご相談への助言に加えて、設定作業やアカウント発行などの実務にも対応します。範囲はご契約時にすり合わせます。" },
  { q: "付き合いのあるITベンダーや、社内に詳しい社員がいます。役割はどうなりますか？", a: "既存のご契約や役割分担はそのままで、社内側の相談相手として加わります。なお、ベンダーへの発注・契約・調整の代行は承っていません。" },
  { q: "途中でやめられますか？", a: "はい。最低契約期間はなく、1ヶ月前までのお申し出で解約できます。" },
  { q: "費用はどのくらいですか？", a: "月10万円〜（税別）が目安で、支援範囲と頻度によって変わります。詳しくは<a href=\"/pricing.html\">料金ページ</a>をご覧ください。" },
];
---
<BaseLayout
  title="情シス伴走支援「もうひとりの情シス」 | 株式会社ネクストブリッジ"
  description="専任の情シスがいない会社のIT業務を、月額の顧問契約でまるごと支援。PC・アカウントの管理、セキュリティ整備、SaaSの運用、社員からの相談対応まで、「もうひとりの情シス」として伴走します。"
  ogTitle="情シス伴走支援「もうひとりの情シス」 | NEXT Bridge"
  ogDescription="専任の情シスがいない会社のIT業務を、月額の顧問契約でまるごと支援。相談から実務まで「もうひとりの情シス」として伴走します。"
>
  <!-- イラスト素材: ソコスト https://soco-st.com（商用利用可・クレジット不要）。ブランドカラーに合わせて一部の色を変更 -->

  <section class="lp-hero">
    <div class="container lp-hero-inner">
      <div class="lp-hero-copy">
        <p class="lp-hero-label">情シス伴走支援</p>
        <h1>あなたのチームに、<br>もうひとりの情シスを。</h1>
        <p class="lp-hero-sub">PCやアカウントの管理、セキュリティ、社員からの「困った」への対応まで。専任の情シスがいない会社のIT業務を、月額の顧問契約で引き受けます。</p>
        <div class="lp-hero-cta">
          <a href="/contact.html" class="btn btn-primary btn-lg">無料で相談する</a>
        </div>
        <ul class="lp-hero-points">
          <li>3年以上の継続支援実績</li>
          <li>助言と実作業の両方に対応</li>
          <li>会社の成長に合わせて調整</li>
        </ul>
      </div>
      <div class="lp-hero-visual">
        <img src="/images/ill-support.svg" alt="" width="354" height="273">
      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">PROBLEM</p>
        <h2>ITの「困った」、<br class="pc-br">こうなっていませんか？</h2>
      </div>
      <div class="lp-worry">
        <figure class="lp-worry-ill">
          <img src="/images/ill-worry-woman.svg" alt="" loading="lazy" width="409" height="350">
        </figure>
        <ul class="lp-checklist">
          <li>入退社のたびにPCやアカウントの設定に追われる</li>
          <li>総務や経営者がITを兼務している</li>
          <li>セキュリティが不安だが、何から手を付けるか分からない</li>
          <li>SaaSやアカウントが管理されないまま増えていく</li>
          <li>詳しい社員に「なんとなく」頼ってしまっている</li>
          <li>情シスを採用するほどの仕事量ではない</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="lp-band">
    <div class="container">
      <p class="lp-band-label">NEXT Bridge の情シス伴走支援</p>
      <p class="lp-band-copy">採用するほどではない。<br class="pc-br">でも、いないと回らない。</p>
      <p class="lp-band-sub">情シス一人分の仕事を、必要な分だけ。「もうひとりの情シス」が引き受けます。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FEATURE</p>
        <h2>3つの特長</h2>
      </div>
      <div class="lp-features">

        <div class="lp-feature">
          <div class="lp-feature-text">
            <span class="lp-feature-num">01</span>
            <h3>相談から実務まで、手も動かす</h3>
            <p>方針の助言も、PCのセットアップ、アカウントの発行、SaaSの設定変更などの実務も引き受けます。</p>
          </div>
          <div class="lp-flowfig" role="img" aria-label="困ったらまず相談。もうひとりの情シスが助言と実作業で対応し、解決後は仕組み化して再発を防ぐ流れ">
            <div class="lp-flowfig-node">
              <strong>困ったら、まず相談</strong>
              <span>メール・チャットでOK</span>
            </div>
            <div class="lp-flowfig-arrow" aria-hidden="true"></div>
            <div class="lp-flowfig-node lp-flowfig-node--accent">
              <strong>もうひとりの情シスが対応</strong>
              <span>助言＋実作業</span>
            </div>
            <div class="lp-flowfig-arrow" aria-hidden="true"></div>
            <div class="lp-flowfig-node">
              <strong>仕組み化して再発を防ぐ</strong>
              <span>手順化・自動化</span>
            </div>
            <div class="lp-flowfig-arrow" aria-hidden="true"></div>
            <div class="lp-flowfig-result">
              <span>窓口はひとつ。たらい回しになりません</span>
            </div>
          </div>
        </div>

        <div class="lp-feature lp-feature--reverse">
          <div class="lp-feature-text">
            <span class="lp-feature-num">02</span>
            <h3>会社の成長に合わせて、範囲を調整</h3>
            <p>10名の立ち上げ期から100名規模の拡大期まで。入退社対応だけ、セキュリティ整備だけ、といった頼み方もできます。</p>
          </div>
          <figure class="lp-feature-ill">
            <img src="/images/ill-handshake.svg" alt="" loading="lazy" width="365" height="239">
          </figure>
        </div>

        <div class="lp-feature">
          <div class="lp-feature-text">
            <span class="lp-feature-num">03</span>
            <h3>セキュリティも実務レベルで</h3>
            <p>ISMS運用や Intune 構築の支援が本業です。ウイルス対策に加えて、端末管理やアカウント統制まで含めた守りを整えます。</p>
          </div>
          <figure class="lp-feature-ill">
            <img src="/images/ill-shieldpc.svg" alt="" loading="lazy" width="255" height="282">
          </figure>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">SCOPE</p>
        <h2>お任せいただける業務</h2>
      </div>
      <ul class="lp-checklist lp-checklist--check lp-checklist--cols2">
        <li>入退社にともなうPC・アカウントの手配</li>
        <li>Microsoft 365 / Google Workspace の管理</li>
        <li>SaaSの選定・契約内容の整理・棚卸し</li>
        <li>セキュリティ対策の整備（EDR・MDM など）</li>
        <li>社員からの問い合わせ対応</li>
        <li>ネットワーク・複合機などオフィスのIT</li>
        <li>IT資産の台帳整備</li>
        <li>ISMS・Pマーク運用の下支え</li>
      </ul>
    </div>
  </section>

  <LpConsult
    text="ITの「困った」、まとめて相談してみませんか？"
    note="費用の目安: 顧問契約 月10万円〜（税別）。定例ミーティングと随時のご相談を含み、金額は支援範囲と頻度により変わります。"
  />

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FLOW</p>
        <h2>支援の流れ</h2>
      </div>
      <LpSteps steps={steps} />
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">CASE</p>
        <h2>支援事例</h2>
      </div>
      <div class="ill ill--center">
        <img src="/images/ill-meeting.svg" alt="" loading="lazy" width="398" height="247">
      </div>
      <div class="case-grid">
        <CaseCard data={itStartupCase.summary} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FAQ</p>
        <h2>よくあるご質問</h2>
      </div>
      <LpFaq items={faqItems} />
      <LpBanner text="Intune / Entra ID によるデバイス管理基盤の構築は専用ページでご案内しています" href="/device-management/" label="デバイス管理導入支援" />
    </div>
  </section>

  <Cta
    heading="ITまわりの「そのうちやる」、一度整理しませんか"
    text="現状を伺って、優先順位と進め方をご提案します。初回相談は無料です。"
    buttonClass="btn btn-primary"
    buttonLabel="相談してみる"
  />
</BaseLayout>
