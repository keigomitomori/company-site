---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import CaseCard from '../../components/CaseCard.astro';
import { deviceManagementCase } from '../../data/cases';
import LpSteps from '../../components/LpSteps.astro';
import { ill } from '../../data/illustrations';
import LpFaq from '../../components/LpFaq.astro';
import LpBanner from '../../components/LpBanner.astro';
import LpConsult from '../../components/LpConsult.astro';

const steps = [
  { image: ill.magnifier, title: "現状調査", items: ["端末・ライセンスの棚卸し", "いまの運用の確認"] },
  { image: ill.document, title: "設計", items: ["ポリシー・構成の設計", "設計書・パラメータシート整備"] },
  { image: ill.shieldpc, title: "構築・展開", items: ["検証してから段階展開", "既存端末の移行計画"] },
  { image: ill.growth, title: "運用引き継ぎ", items: ["運用手順書の整備", "社内担当への引き継ぎ"] },
];

const faqItems = [
  { q: "何台くらいの規模から頼めますか？", a: "数十台規模からご相談いただけます。構築実績の中心は100〜200台規模です。" },
  { q: "ライセンスは何が必要ですか？", a: "Microsoft 365 Business Premium 以上が目安です。現在のご契約内容を確認したうえで、過不足をご提案します。" },
  { q: "いま使っているPCも管理下に入れられますか？", a: "はい。使用中の端末を段階的に登録する移行計画を立てて進めます。PCの入れ替え時期に合わせる進め方も可能です。" },
  { q: "構築後の運用もお願いできますか？", a: "はい。情シス伴走支援の顧問契約で、構築後の運用まで継続して支援できます。" },
  { q: "費用はどのくらいですか？", a: "30万円〜（税別）が目安で、台数と構成によって変わります。詳しくは<a href=\"/pricing.html\">料金ページ</a>をご覧ください。" },
];
---
<BaseLayout
  title="Intune / Entra ID デバイス管理導入支援 | 株式会社ネクストブリッジ"
  description="Microsoft Intune / Entra ID によるデバイス管理基盤の設計・構築を支援。PC 100〜200台規模の構築実績。Autopilot によるキッティング自動化、セキュリティポリシーの一括適用、運用の引き継ぎまで一貫して支援します。"
  ogTitle="Intune / Entra ID デバイス管理導入支援 | NEXT Bridge"
  ogDescription="Microsoft Intune / Entra ID によるデバイス管理基盤の設計・構築を支援。キッティング自動化から運用定着まで。"
>
  <!-- イラスト素材: ソコスト https://soco-st.com（商用利用可・クレジット不要）。ブランドカラーに合わせて一部の色を変更 -->

  <section class="lp-hero">
    <div class="container lp-hero-inner">
      <div class="lp-hero-copy">
        <p class="lp-hero-label">デバイス管理導入支援</p>
        <h1>会社のPCを<br>仕組みで管理する。</h1>
        <p class="lp-hero-sub">Microsoft Intune / Entra ID を使ったデバイス管理基盤を、設計から構築、運用の引き継ぎまで支援します。PC 100〜200台規模の構築実績があります。</p>
        <div class="lp-hero-cta">
          <a href="/contact.html" class="btn btn-primary btn-lg">無料で相談する</a>
        </div>
        <ul class="lp-hero-points">
          <li>100〜200台規模の構築実績</li>
          <li>設計から運用引き継ぎまで</li>
          <li>Microsoft 365 環境が得意</li>
        </ul>
      </div>
      <div class="lp-hero-visual">
        <img src="/images/ill-coding.svg" alt="" width="342" height="262">
      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">PROBLEM</p>
        <h2>PCの管理、<br class="pc-br">こうなっていませんか？</h2>
      </div>
      <div class="lp-worry">
        <figure class="lp-worry-ill">
          <img src="/images/ill-worry-man.svg" alt="" loading="lazy" width="418" height="357">
        </figure>
        <ul class="lp-checklist">
          <li>どの端末が社内にあるか、正確に把握できていない</li>
          <li>新しいPCのセットアップが毎回手作業</li>
          <li>退職者のアカウント処理が場当たり的</li>
          <li>セキュリティ設定が端末ごとにバラバラ</li>
          <li>私物端末からのアクセスを制御できていない</li>
          <li>Microsoft 365 のライセンスを活かしきれていない</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="lp-band">
    <div class="container">
      <p class="lp-band-label">NEXT Bridge のデバイス管理導入支援</p>
      <p class="lp-band-copy">台帳で追いかける管理から、<br class="pc-br">仕組みで守る管理へ。</p>
      <p class="lp-band-sub">Intune / Entra ID で、端末の把握・設定・保護を自動化します。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FEATURE</p>
        <h2>3つの特長</h2>
      </div>
      <div class="lp-features">

        <div class="lp-feature">
          <div class="lp-feature-text">
            <span class="lp-feature-num">01</span>
            <h3>キッティングを自動化する</h3>
            <p>Windows Autopilot と Intune で、箱から出して電源を入れるだけのセットアップに。入社のたびの手作業をなくします。</p>
          </div>
          <div class="lp-flowfig" role="img" aria-label="PCを箱から出し、電源を入れてサインインすると、設定とアプリが自動で適用される。手作業がなくなり、設定漏れも起きない">
            <div class="lp-flowfig-node">
              <strong>箱から出す</strong>
              <span>新品PCをそのまま渡せる</span>
            </div>
            <div class="lp-flowfig-arrow" aria-hidden="true"></div>
            <div class="lp-flowfig-node">
              <strong>電源を入れてサインイン</strong>
              <span>社員本人の操作はこれだけ</span>
            </div>
            <div class="lp-flowfig-arrow" aria-hidden="true"></div>
            <div class="lp-flowfig-node lp-flowfig-node--accent">
              <strong>設定・アプリが自動で入る</strong>
              <span>Autopilot / Intune</span>
            </div>
            <div class="lp-flowfig-arrow" aria-hidden="true"></div>
            <div class="lp-flowfig-result">
              <span>手作業ゼロ、設定漏れもゼロ</span>
            </div>
          </div>
        </div>

        <div class="lp-feature lp-feature--reverse">
          <div class="lp-feature-text">
            <span class="lp-feature-num">02</span>
            <h3>セキュリティ設定を全端末に一括適用</h3>
            <p>ディスクの暗号化、画面ロック、OSの更新。会社の基準を Intune のポリシーとして配布し、端末ごとのばらつきをなくします。</p>
          </div>
          <figure class="lp-feature-ill">
            <img src="/images/ill-shieldpc.svg" alt="" loading="lazy" width="255" height="282">
          </figure>
        </div>

        <div class="lp-feature">
          <div class="lp-feature-text">
            <span class="lp-feature-num">03</span>
            <h3>導入して終わりにしない</h3>
            <p>設計書と運用手順書を整備し、日々の運用を引き継ぐところまで支援します。「作った人しか触れない」基盤にしません。</p>
          </div>
          <figure class="lp-feature-ill">
            <img src="/images/ill-training.svg" alt="" loading="lazy" width="456" height="309">
          </figure>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">BEFORE / AFTER</p>
        <h2>導入すると、ここまで変わります</h2>
      </div>
      <div class="lp-ba" role="img" aria-label="導入前は、どの端末があるか正確に分からず、新しいPCのたびに手作業で、セキュリティ設定も端末ごとにバラバラ。導入後は、全端末を一覧で把握でき、電源を入れるだけでセットアップが終わり、会社基準の設定が全端末に一括適用される">
        <div class="lp-ba-head" aria-hidden="true">
          <span class="lp-ba-topic"></span>
          <span class="lp-ba-chip">導入前</span>
          <span></span>
          <span class="lp-ba-chip lp-ba-chip--accent">導入後</span>
        </div>
        <div class="lp-ba-row" aria-hidden="true">
          <span class="lp-ba-topic">端末の把握</span>
          <p class="lp-ba-cell lp-ba-cell--before">どの端末があるか正確に分からない</p>
          <span class="lp-ba-arrow"></span>
          <p class="lp-ba-cell lp-ba-cell--after">全端末を一覧で把握</p>
        </div>
        <div class="lp-ba-row" aria-hidden="true">
          <span class="lp-ba-topic">セットアップ</span>
          <p class="lp-ba-cell lp-ba-cell--before">新しいPCのたびに手作業</p>
          <span class="lp-ba-arrow"></span>
          <p class="lp-ba-cell lp-ba-cell--after">電源を入れるだけで完了</p>
        </div>
        <div class="lp-ba-row" aria-hidden="true">
          <span class="lp-ba-topic">セキュリティ設定</span>
          <p class="lp-ba-cell lp-ba-cell--before">端末ごとにバラバラ</p>
          <span class="lp-ba-arrow"></span>
          <p class="lp-ba-cell lp-ba-cell--after">会社基準を全端末に一括適用</p>
        </div>
        <p class="lp-ba-sum" aria-hidden="true">
          <span class="lp-ba-sum-before">台帳と実態が、合っていない</span>
          <span class="lp-ba-sum-arrow"></span>
          <span class="lp-ba-sum-after">全端末が、見える・守られている</span>
        </p>
      </div>
    </div>
  </section>

  <LpConsult text="「いまの環境からでも移行できる？」— まずは現状をお聞かせください。" />

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FLOW</p>
        <h2>支援の流れ</h2>
      </div>
      <LpSteps steps={steps} />
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">CASE</p>
        <h2>支援事例</h2>
      </div>
      <div class="ill ill--center">
        <img src="/images/ill-handshake.svg" alt="" loading="lazy" width="365" height="239">
      </div>
      <div class="case-grid">
        <CaseCard data={deviceManagementCase.summary} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FAQ</p>
        <h2>よくあるご質問</h2>
      </div>
      <LpFaq items={faqItems} />
      <LpBanner text="この基盤の上で、Claude Code など生成AIツールの配布統制も実現できます" href="/genai-governance/" label="生成AI・Claude Codeの社内統制支援" />
    </div>
  </section>

  <Cta
    heading="PCの管理、仕組みにしませんか"
    text="現在の環境と台数を伺い、移行の進め方と概算をご提案します。相談は無料です。"
    buttonClass="btn btn-primary"
    buttonLabel="相談してみる"
  />
</BaseLayout>
