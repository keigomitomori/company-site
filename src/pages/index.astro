---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import { getCollection } from 'astro:content';
import LpBanner from '../components/LpBanner.astro';

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// お知らせは最新の公開コラムから自動生成する（手動更新不要）
const latestArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '株式会社ネクストブリッジ',
  alternateName: 'NEXT Bridge',
  url: 'https://nextb.net/',
  logo: 'https://nextb.net/images/logo.webp',
  address: {
    '@type': 'PostalAddress',
    postalCode: '104-0061',
    addressRegion: '東京都',
    addressLocality: '中央区',
    streetAddress: '銀座1-12-4 N&E BLD.7階',
    addressCountry: 'JP',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    url: 'https://nextb.net/contact.html',
    availableLanguage: 'ja',
  },
});
---
<BaseLayout
  title="株式会社ネクストブリッジ | 導入するだけのITから、使われるITへ。"
  description="株式会社ネクストブリッジの公式サイトです。情シスコンサルティング・製品導入支援・生成AI導入支援を行っています。"
  ogTitle="NEXT Bridge｜導入するだけのITから、使われるITへ。"
  ogDescription="情シスコンサルティング・製品導入支援・生成AI導入支援を行っています。"
>
  <script type="application/ld+json" set:html={orgJsonLd} />

  <section class="hero hero--cover">
    <div class="container">
      <div class="hero-copy">
        <p class="hero-eyebrow">情シスコンサルティング / 製品導入支援 / 生成AI導入支援</p>
        <h1>導入するだけのITから、<br>使われるITへ。</h1>
        <p class="hero-lead">技術を届けるだけでなく、現場に根づくITを。<br>NEXT Bridgeが、その橋渡しをします。</p>
        <div class="hero-actions">
          <a href="/contact.html" class="btn btn-primary">相談してみる</a>
          <a href="/services.html#cases" class="btn btn-outline">支援事例を見る</a>
        </div>
        <ul class="hero-badges">
          <li><strong>長期の伴走支援</strong><span>数年単位で続くご支援も</span></li>
          <li><strong>戦略から実務まで</strong><span>自ら手を動かして支援</span></li>
          <li><strong>中立の製品選定</strong><span>特定製品の販売代理なし</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="news-bar">
    <div class="container">
      <h2>お知らせ</h2>
      <ul class="news-list">
        {latestArticles.map((article) => (
          <li>
            <time datetime={article.data.pubDate.toISOString().split('T')[0]}>{fmt(article.data.pubDate)}</time>
            <a href={`/articles/${article.id}/`}>コラム「{article.data.title}」を公開しました</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="section-title">
        <h2>NEXT Bridgeの特長</h2>
        <p>Strengths</p>
      </div>
      <div class="features-grid">
        <div class="feature-item">
          <span class="feature-num">01</span>
          <h3>長く伴走する前提のお付き合い</h3>
          <p>単発の助言で終わらせず、チームの一員として継続的に支えます。顧問契約は最長で3年以上続いています。</p>
        </div>
        <div class="feature-item">
          <span class="feature-num">02</span>
          <h3>戦略から実務まで手を動かす</h3>
          <p>方針づくりだけで終わらせません。設定の投入、手順書の整備、社内向け研修まで自ら手を動かします。</p>
        </div>
        <div class="feature-item">
          <span class="feature-num">03</span>
          <h3>ツールを売らない中立の立場</h3>
          <p>特定製品の販売代理を行わないため、貴社の環境と目的に合わせた選定・設計ができます。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>支援メニュー</h2>
        <p>Services</p>
      </div>
      <div class="card-grid card-grid--lp">
        <a href="/device-management/" class="card card--link">
          <div class="card-illust">
            <img src="/images/ill-coding.svg" alt="" loading="lazy" width="342" height="262">
          </div>
          <div class="card-body">
            <h3>デバイス管理導入支援</h3>
            <p>Intune / Entra ID でPCの管理を仕組み化。キッティングの自動化から運用の引き継ぎまで支援します。</p>
            <span class="card-more">詳しく見る →</span>
          </div>
        </a>
        <a href="/genai-adoption/" class="card card--link">
          <div class="card-illust">
            <img src="/images/ill-growth.svg" alt="" loading="lazy" width="458" height="345">
          </div>
          <div class="card-body">
            <h3>生成AI活用支援</h3>
            <p>効果の出る業務を見極めて、試作・現場評価から全社展開まで伴走します。</p>
            <span class="card-more">詳しく見る →</span>
          </div>
        </a>
        <a href="/genai-governance/" class="card card--link">
          <div class="card-illust">
            <img src="/images/ill-shieldpc.svg" alt="" loading="lazy" width="255" height="282">
          </div>
          <div class="card-body">
            <h3>生成AI・Claude Codeの社内統制支援</h3>
            <p>ガイドラインと設定による強制で、生成AIを安全に使える状態を作ります。</p>
            <span class="card-more">詳しく見る →</span>
          </div>
        </a>
        <a href="/it-support/" class="card card--link">
          <div class="card-illust">
            <img src="/images/ill-support.svg" alt="" loading="lazy" width="354" height="273">
          </div>
          <div class="card-body">
            <h3>情シス伴走支援「もうひとりの情シス」</h3>
            <p>専任の情シスがいない会社のIT業務を、月額の顧問契約でまるごと支援します。</p>
            <span class="card-more">詳しく見る →</span>
          </div>
        </a>
      </div>
      <LpBanner text="それぞれの料金の目安は料金ページでご案内しています" href="/pricing.html" label="料金" />
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="split">
        <div class="statement">
          <div class="section-title">
            <h2>あなたのチームに、<br>もうひとりの情シスを。</h2>
            <p>Philosophy</p>
          </div>
          <p>ITの困りごとは、社内では相談しづらいものです。人数が限られた情報システム部門であればなおさら、判断に迷う場面や、手が回らない業務が増えていきます。</p>
          <p>私たちは、そうした現場に外からチームの一員として加わり、戦略の立案から日々の運用まで一緒に取り組みます。</p>
          <p>必要なのは、一時的なアドバイスではなく、継続的に頼れる存在。御社の情シスの「もうひとり」として、技術と経験でお力になります。</p>
          <a href="/about.html" class="btn btn-outline">会社概要を見る</a>
        </div>
        <figure class="figure">
          <div class="orgfig">
            <div class="orgfig-top">
              <div class="orgfig-node">
                <img src="/images/ill-team.svg" alt="" loading="lazy" width="455" height="365">
                <strong>お客様チーム</strong>
                <span>経営・現場・IT兼務</span>
              </div>
              <div class="orgfig-link">
                <span class="orgfig-pill">定例・随時相談</span>
                <svg class="orgfig-arrow" viewBox="0 0 64 12" aria-hidden="true"><path d="M 8 6 H 56 M 8 6 L 14 2 M 8 6 L 14 10 M 56 6 L 50 2 M 56 6 L 50 10" stroke="#2563eb" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div class="orgfig-node orgfig-node--nb">
                <img src="/images/ill-consultant.svg" alt="" loading="lazy" width="455" height="365">
                <strong>NEXT Bridge</strong>
                <span>もうひとりの情シス</span>
              </div>
            </div>
            <div class="orgfig-domains">
              <span class="orgfig-domains-label">受け持つ領域</span>
              <ul>
                <li>デバイス管理</li>
                <li>SaaS・アカウント</li>
                <li>セキュリティ・ISMS</li>
                <li>生成AI統制</li>
              </ul>
            </div>
          </div>
          <figcaption>ご支援のイメージ: チームの一員として、社内ITの実務を広く受け持ちます</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="highlight-dark">
    <div class="container">
      <div class="highlight-inner">
        <div>
          <p class="eyebrow-light">Case</p>
          <p class="highlight-text">専任情シスが不在のスタートアップを、3年以上「もうひとりの情シス」として支援しています。</p>
        </div>
        <a href="/services.html#cases" class="btn btn-outline">支援事例を見る</a>
      </div>
    </div>
  </section>

  <Cta buttonClass="btn btn-primary" />
</BaseLayout>
