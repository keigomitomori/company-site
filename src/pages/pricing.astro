---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Cta from '../components/Cta.astro';
import LpSteps from '../components/LpSteps.astro';
import { ill } from '../data/illustrations';
import LpFaq from '../components/LpFaq.astro';

const steps = [
  { image: ill.magnifier, title: "無料相談", items: ["現状と困りごとを伺います", "オンラインで30分程度"] },
  { image: ill.meeting, title: "範囲のすり合わせ", items: ["やること・やらないことを整理", "ご予算に合わせて調整"] },
  { image: ill.document, title: "お見積もり", items: ["金額と進め方をご提示", "お見積もりは無料です"] },
  { image: ill.handshake, title: "ご契約・開始", items: ["契約手続きのうえ支援開始", "開始後も範囲を調整できます"] },
];

const faqItems = [
  { q: "相談やお見積もりに費用はかかりますか？", a: "かかりません。初回相談とお見積もりは無料です。" },
  { q: "予算が決まっています。範囲を合わせてもらえますか？", a: "はい。優先順位を付けて、ご予算に収まる範囲からのご提案もできます。" },
  { q: "契約形態は請負ですか？準委任ですか？", a: "いずれのご支援も準委任契約です。業務の遂行に対して対価をいただく形で、成果物の完成をお約束する請負契約は承っていません。" },
  { q: "顧問契約に最低契約期間はありますか？", a: "設けていません。解約は1ヶ月前までにお申し出ください。" },
  { q: "顧問契約とプロジェクト型支援は併用できますか？", a: "はい。構築はプロジェクト型で、その後の運用は顧問契約で、という組み合わせが多いです。" },
  { q: "支援の範囲は途中で変えられますか？", a: "はい。定例ミーティングで状況を見ながら、範囲や頻度を調整できます。" },
];
---
<BaseLayout
  title="料金 | 株式会社ネクストブリッジ"
  description="NEXT Bridgeの料金のご案内。月額の顧問契約は月10万円〜、期間を定めたプロジェクト型支援は30万円〜が目安です。ご契約はいずれも準委任です。初回相談とお見積もりは無料。支援範囲に合わせて個別にお見積もりします。"
  canonical="https://nextb.net/pricing.html"
  ogTitle="料金 | NEXT Bridge"
  ogDescription="顧問契約は月10万円〜、プロジェクト型支援は30万円〜が目安（いずれも準委任）。初回相談とお見積もりは無料です。"
>
  <PageHeader title="料金" subtitle="Pricing" />

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">PLAN</p>
        <h2>2つのご契約形態</h2>
      </div>
      <p class="price-lead">料金は支援範囲に応じて個別にお見積もりします。以下は下限の目安です。</p>
      <div class="price-grid">
        <div class="price-card">
          <div class="price-ill" aria-hidden="true">
            <img src="/images/ill-document.svg" alt="" loading="lazy" width="215" height="199">
          </div>
          <h3>プロジェクト型支援</h3>
          <p class="price-amount">30万円<span>〜（税別）</span></p>
          <p class="price-note">期間と支援範囲を決めて進めるご支援</p>
          <ul class="feature-list">
            <li>デバイス管理基盤の設計・構築</li>
            <li>生成AIの導入・活用支援</li>
            <li>ガイドライン策定・統制の立ち上げ</li>
          </ul>
        </div>
        <div class="price-card">
          <div class="price-ill" aria-hidden="true">
            <img src="/images/ill-handshake.svg" alt="" loading="lazy" width="365" height="239">
          </div>
          <h3>顧問契約</h3>
          <p class="price-amount">月10万円<span>〜（税別）</span></p>
          <p class="price-note">継続して伴走するご支援</p>
          <ul class="feature-list">
            <li>情シス伴走支援「もうひとりの情シス」</li>
            <li>構築後の運用・統制の継続支援</li>
            <li>定例ミーティング＋随時のご相談</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">ESTIMATE</p>
        <h2>サービス別の料金目安</h2>
      </div>
      <div class="price-table-wrap">
        <table class="price-table">
          <thead>
            <tr>
              <th>サービス</th>
              <th>契約形態</th>
              <th>目安</th>
              <th>金額が変わる主な要因</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th><a href="/device-management/">デバイス管理導入支援</a></th>
              <td>プロジェクト型</td>
              <td>30万円〜</td>
              <td>台数・構成の複雑さ</td>
            </tr>
            <tr>
              <th><a href="/genai-adoption/">生成AI活用支援</a></th>
              <td>プロジェクト型</td>
              <td>30万円〜</td>
              <td>対象業務の数・期間</td>
            </tr>
            <tr>
              <th><a href="/genai-governance/">生成AI・Claude Codeの社内統制支援</a></th>
              <td>顧問／プロジェクト型</td>
              <td>30万円〜</td>
              <td>統制範囲・端末数</td>
            </tr>
            <tr>
              <th><a href="/scs/">SCS評価制度対応支援</a></th>
              <td>顧問／プロジェクト型</td>
              <td>30万円〜</td>
              <td>目指す段階・現状の整備状況</td>
            </tr>
            <tr>
              <th><a href="/it-support/">情シス伴走支援</a></th>
              <td>顧問契約</td>
              <td>月10万円〜</td>
              <td>支援範囲・頻度</td>
            </tr>
          </tbody>
        </table>
      </div>
      <ul class="price-notes">
        <li>※ ご契約はいずれも準委任契約です。業務の遂行に対して対価をいただく形で、成果物の完成をお約束する請負契約は承っていません。</li>
        <li>※ 金額はいずれも税別の目安です。正式なお見積もりは、無料相談で状況を伺ったうえでご提示します。</li>
        <li>※ 統制支援（生成AI・SCS評価制度対応）を顧問契約で継続運用する場合は、月10万円〜が目安です。</li>
        <li>※ SCS評価制度対応支援の金額は当社の支援費用です。制度への申請や専門家確認・第三者評価にかかる費用（未公表）は含みません。</li>
        <li>※ 構築はプロジェクト型、その後の運用は顧問契約、という組み合わせもできます。</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FLOW</p>
        <h2>お見積もりの流れ</h2>
      </div>
      <LpSteps steps={steps} />
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FAQ</p>
        <h2>料金に関するよくあるご質問</h2>
      </div>
      <LpFaq items={faqItems} />
    </div>
  </section>

  <Cta
    heading="料金のご相談は、お気軽にどうぞ"
    text="状況を伺えれば、初回相談の場でおおよその概算感をお伝えできます。"
    buttonClass="btn btn-primary"
    buttonLabel="無料で相談する"
  />
</BaseLayout>
