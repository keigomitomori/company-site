---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import CaseCard from '../../components/CaseCard.astro';
import { claudeEnterpriseCase, claudeCodeGovernanceCase } from '../../data/cases';
import LpSteps from '../../components/LpSteps.astro';
import { ill } from '../../data/illustrations';
import LpFaq from '../../components/LpFaq.astro';
import LpConsult from '../../components/LpConsult.astro';

const steps = [
  { image: ill.magnifier, title: "現状診断", items: ["利用実態の棚卸し", "プラン選定の支援", "機密データの区分整理"] },
  { image: ill.document, title: "ルール策定", items: ["利用ガイドライン作成", "入力してよい情報の線引き", "例外承認フローの設計"] },
  { image: ill.shieldpc, title: "技術統制", items: ["SSO・アカウント統制", "managed settings 設計", "Intune / MDM 配布"] },
  { image: ill.growth, title: "定着支援", items: ["社内勉強会・研修", "利用状況の分析", "推進担当の育成"] },
];

const faqItems = [
  { q: "何から相談すればいいですか？", a: "現状の共有だけで大丈夫です。利用状況やお使いの環境（Microsoft 365 など）をお聞きして、進め方をご提案します。" },
  { q: "ガイドラインはすでにあります。途中からでも頼めますか？", a: "はい。設定による統制だけ、定着支援だけなど、必要な部分からお手伝いできます。" },
  { q: "ISMS認証を運用中です。整合できますか？", a: "はい。リスクアセスメントへの載せ方から規程との整合まで、ISMSの運用に沿った形で進めます。" },
  { q: "Claude 以外の生成AIにも対応できますか？", a: "Claude・Claude Code を中心としつつ、他の生成AIを含めた利用ルールづくりもご相談いただけます。" },
];
---
<BaseLayout
  title="生成AI・Claude Codeの社内統制支援 | 株式会社ネクストブリッジ"
  description="Claude・Claude Codeを安全に社内展開するための統制支援です。利用ガイドライン策定、SSO・アカウント統制、managed settingsの設計、Intune/MDMでの配布、ISMSとの整合まで、情シスの視点で一貫して支援します。"
  ogTitle="生成AI・Claude Codeの社内統制支援 | NEXT Bridge"
  ogDescription="Claude・Claude Codeを安全に社内展開するための統制支援。ガイドライン策定からmanaged settings・MDM配布・ISMS整合まで。"
  ogImage="https://nextb.net/images/og-genai-governance.png"
>
  <!-- イラスト素材: ソコスト https://soco-st.com（商用利用可・クレジット不要）。ブランドカラーに合わせて一部の色を変更 -->

  <section class="lp-hero">
    <div class="container lp-hero-inner">
      <div class="lp-hero-copy">
        <p class="lp-hero-label">生成AI・Claude Codeの社内統制支援</p>
        <h1>生成AIを、<br>安心して全社へ。</h1>
        <p class="lp-hero-sub">Claude・Claude Code の導入設計からルールづくり、設定による統制、社内定着まで。情シスの実務がわかるコンサルタントが伴走します。</p>
        <div class="lp-hero-cta">
          <a href="/contact.html" class="btn btn-primary btn-lg">無料で相談する</a>
        </div>
        <ul class="lp-hero-points">
          <li>実案件にもとづく支援</li>
          <li>導入から定着まで一気通貫</li>
          <li>ツールを売らない中立の立場</li>
        </ul>
      </div>
      <div class="lp-hero-visual">
        <img src="/images/ill-meeting.svg" alt="" width="398" height="247">
      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">PROBLEM</p>
        <h2>生成AIの導入で、<br class="pc-br">こんなお悩みはありませんか？</h2>
      </div>
      <div class="lp-worry">
        <figure class="lp-worry-ill">
          <img src="/images/ill-worry.svg" alt="" loading="lazy" width="416" height="291">
        </figure>
        <ul class="lp-checklist">
          <li>安全な導入の進め方がわからない</li>
          <li>社員が個人アカウントで使い始めている</li>
          <li>Claude Code の設定や権限を管理しきれない</li>
          <li>ガイドラインを作ったのに守られていない</li>
          <li>ISMSのリスクアセスメントにどう載せるか悩ましい</li>
          <li>導入したのに一部の社員しか使っていない</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="lp-band">
    <div class="container">
      <p class="lp-band-label">NEXT Bridge の生成AI統制支援</p>
      <p class="lp-band-copy">ルールで縛るのではなく、<br class="pc-br">仕組みで守る。</p>
      <p class="lp-band-sub">ガイドラインを設定に落とし込み、全端末へ配布。「守ってください」で終わらせません。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FEATURE</p>
        <h2>3つの特長</h2>
      </div>
      <div class="lp-features">

        <div class="lp-feature">
          <div class="lp-feature-text">
            <span class="lp-feature-num">01</span>
            <h3>ルールを設定として全端末に配布</h3>
            <p>ガイドラインを managed settings に落とし込み、Intune / MDM で一括配布。設定は個人では変えられないため、ルールが形骸化しません。</p>
          </div>
          <div class="lp-flowfig" role="img" aria-label="ルールを決め、managed settings として設定に落とし込み、Intune / MDM で全端末に配布して強制する。証跡が残り、監査・ISMSで説明できる">
            <div class="lp-flowfig-node">
              <strong>ルールを決める</strong>
              <span>ガイドライン</span>
            </div>
            <div class="lp-flowfig-arrow" aria-hidden="true"></div>
            <div class="lp-flowfig-node">
              <strong>設定に落とし込む</strong>
              <span>managed settings</span>
            </div>
            <div class="lp-flowfig-arrow" aria-hidden="true"></div>
            <div class="lp-flowfig-node lp-flowfig-node--accent">
              <strong>全端末に配布して強制</strong>
              <span>Intune / MDM</span>
            </div>
            <div class="lp-flowfig-arrow" aria-hidden="true"></div>
            <div class="lp-flowfig-result">
              <span>証跡が残る</span>
              <span class="lp-flowfig-result-arrow" aria-hidden="true"></span>
              <span>監査・ISMSで説明できる</span>
            </div>
          </div>
        </div>

        <div class="lp-feature lp-feature--reverse">
          <div class="lp-feature-text">
            <span class="lp-feature-num">02</span>
            <h3>導入から定着まで、ひとつの窓口で</h3>
            <p>プラン選定、ルールづくり、技術設定、社員向けの研修まで。窓口を分けずに進められるため、抜け漏れも手戻りも起きにくくなります。</p>
          </div>
          <figure class="lp-feature-ill">
            <img src="/images/ill-training.svg" alt="" loading="lazy" width="456" height="309">
          </figure>
        </div>

        <div class="lp-feature">
          <div class="lp-feature-text">
            <span class="lp-feature-num">03</span>
            <h3>ISMSや既存のIT統制と、無理なく整合</h3>
            <p>ISMS運用やデバイス管理の支援が本業です。生成AIの統制を、いまある規程や認証運用と矛盾なく組み込みます。</p>
          </div>
          <figure class="lp-feature-ill">
            <img src="/images/ill-lockpc.svg" alt="" loading="lazy" width="272" height="190">
          </figure>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">BEFORE / AFTER</p>
        <h2>統制が効くと、ここまで変わります</h2>
      </div>
      <div class="lp-ba" role="img" aria-label="統制前は、社員が個人アカウントで使い、ガイドラインを作っても守られず、統制の状況を説明できない。統制後は、会社管理のアカウントに集約され、ルールは設定として配布されて個人では変えられず、設定と配布の証跡で監査・ISMSに説明できる">
        <div class="lp-ba-head" aria-hidden="true">
          <span class="lp-ba-topic"></span>
          <span class="lp-ba-chip">統制前</span>
          <span></span>
          <span class="lp-ba-chip lp-ba-chip--accent">統制後</span>
        </div>
        <div class="lp-ba-row" aria-hidden="true">
          <span class="lp-ba-topic">アカウント</span>
          <p class="lp-ba-cell lp-ba-cell--before">個人アカウントで使っている</p>
          <span class="lp-ba-arrow"></span>
          <p class="lp-ba-cell lp-ba-cell--after">会社管理のアカウントに集約</p>
        </div>
        <div class="lp-ba-row" aria-hidden="true">
          <span class="lp-ba-topic">ルール</span>
          <p class="lp-ba-cell lp-ba-cell--before">ガイドラインを作っても守られない</p>
          <span class="lp-ba-arrow"></span>
          <p class="lp-ba-cell lp-ba-cell--after">設定として配布され、個人では変えられない</p>
        </div>
        <div class="lp-ba-row" aria-hidden="true">
          <span class="lp-ba-topic">監査・ISMS</span>
          <p class="lp-ba-cell lp-ba-cell--before">統制の状況を説明できない</p>
          <span class="lp-ba-arrow"></span>
          <p class="lp-ba-cell lp-ba-cell--after">設定と配布の証跡で説明できる</p>
        </div>
        <p class="lp-ba-sum" aria-hidden="true">
          <span class="lp-ba-sum-before">個人任せで、見えない</span>
          <span class="lp-ba-sum-arrow"></span>
          <span class="lp-ba-sum-after">会社として、見える・説明できる</span>
        </p>
      </div>
    </div>
  </section>

  <LpConsult text="「うちの場合はどう進める？」 — まずは現状をお聞かせください。" />

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FLOW</p>
        <h2>支援の流れ</h2>
      </div>
      <LpSteps steps={steps} />
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">CASE</p>
        <h2>支援事例</h2>
      </div>
      <div class="ill ill--center">
        <img src="/images/ill-handshake.svg" alt="" loading="lazy" width="365" height="239">
      </div>
      <div class="case-grid">
        <CaseCard data={claudeEnterpriseCase.summary} />
        <CaseCard data={claudeCodeGovernanceCase.summary} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lp-title">
        <p class="lp-eyebrow">FAQ</p>
        <h2>よくあるご質問</h2>
      </div>
      <LpFaq items={faqItems} />
    </div>
  </section>

  <Cta
    heading="まずはお気軽にご相談ください"
    text="「何から始めればいいか」の整理からお手伝いします。現状の共有だけで大丈夫です。"
    buttonClass="btn btn-primary"
    buttonLabel="相談してみる"
  />
</BaseLayout>
