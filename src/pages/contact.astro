---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout
  title="お問い合わせ | 株式会社ネクストブリッジ"
  description="NEXT Bridgeへのお問い合わせページです。サービスに関するご質問やお見積もりのご依頼はこちらからどうぞ。"
  canonical="https://nextb.net/contact.html"
  ogTitle="お問い合わせ | NEXT Bridge"
  ogDescription="サービスに関するご質問やお見積もりのご依頼はこちらからどうぞ。"
>
  <PageHeader title="お問い合わせ" subtitle="Contact" />

  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>お問い合わせフォーム</h2>
        <p>下記フォームにご記入のうえ、送信ボタンを押してください</p>
      </div>

      <form class="contact-form" action="https://formspree.io/f/myknjqar" method="POST">
        <!-- JS無効環境でも送信後にサイト内の完了ページへ戻すための Formspree 指定 -->
        <input type="hidden" name="_next" value="https://nextb.net/thanks.html">
        <!-- honeypot: 人間には見えない欄。botが埋めると Formspree 側で破棄される -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none">
        <div class="form-group">
          <label for="company">会社名</label>
          <input type="text" id="company" name="company" autocomplete="organization" placeholder="例：株式会社サンプル">
        </div>

        <div class="form-group">
          <label for="name">お名前 <span class="required">※必須</span></label>
          <input type="text" id="name" name="name" required aria-required="true" autocomplete="name" placeholder="例：山田 太郎">
        </div>

        <div class="form-group">
          <label for="email">メールアドレス <span class="required">※必須</span></label>
          <input type="email" id="email" name="email" required aria-required="true" autocomplete="email" placeholder="例：info@example.com">
        </div>

        <div class="form-group">
          <label for="phone">電話番号</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="例：03-1234-5678">
        </div>

        <div class="form-group">
          <label for="subject">お問い合わせ種別 <span class="required">※必須</span></label>
          <select id="subject" name="subject" required aria-required="true">
            <option value="" disabled selected>選択してください</option>
            <option value="サービスに関するご質問">サービスに関するご質問</option>
            <option value="お見積もりのご依頼">お見積もりのご依頼</option>
            <option value="採用に関するお問い合わせ">採用に関するお問い合わせ</option>
            <option value="その他">その他</option>
          </select>
        </div>

        <div class="form-group">
          <label for="message">お問い合わせ内容 <span class="required">※必須</span></label>
          <textarea id="message" name="message" required aria-required="true" placeholder="お問い合わせ内容をご記入ください"></textarea>
        </div>

        <div class="form-group form-consent">
          <label class="consent-label">
            <input type="checkbox" name="privacy-consent" value="同意する" required aria-required="true">
            <span><a href="/privacy.html" target="_blank" rel="noopener">プライバシーポリシー</a>に同意する <span class="required">※必須</span></span>
          </label>
          <p class="consent-note">ご入力いただいた内容は、お問い合わせへの回答および関連するご提案・お見積もりのご案内のみに利用します。</p>
        </div>

        <div class="form-submit">
          <button type="submit" class="btn btn-primary">送信する</button>
        </div>
      </form>

    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.querySelector('.contact-form');
      if (!form || !window.fetch) return;
      // bfcache 復元時（thanks からブラウザバック等）に送信ボタンを初期状態へ戻す
      window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        var btn = form.querySelector('button[type="submit"]');
        btn.disabled = false;
        btn.textContent = '送信する';
      });
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = '送信中…';
        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' }
        }).then(function (res) {
          if (!res.ok) throw new Error('submit failed');
          try { sessionStorage.setItem('leadSubmitted', '1'); } catch (err) {}
          window.location.href = '/thanks.html';
        }).catch(function () {
          btn.disabled = false;
          btn.textContent = '送信する';
          alert('送信に失敗しました。時間をおいて再度お試しいただくか、contact@nextb.net まで直接ご連絡ください。');
        });
      });
    })();
  </script>
</BaseLayout>
