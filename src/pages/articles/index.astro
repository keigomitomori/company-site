---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Cta from '../../components/Cta.astro';
import { fmt, iso } from '../../utils/date';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---
<BaseLayout
  title="コラム | 株式会社ネクストブリッジ"
  description="情シス・生成AI統制・デバイス管理の実務コラム。企業導入の現場経験に基づいて、情報システム部門の実務に役立つ知見を発信します。"
  ogTitle="コラム | NEXT Bridge"
  ogDescription="情シス・生成AI統制・デバイス管理の実務コラム。"
>
  <PageHeader title="コラム" subtitle="Articles" />

  <section class="section">
    <div class="container">
      <ul class="article-list">
        {articles.map((article) => (
          <li class="article-list-item">
            <a href={`/articles/${article.id}/`}>
              <img class="article-list-thumb" src={`/images/og/${article.id}.png`} alt="" loading="lazy" width="1200" height="630">
              <div class="article-list-body">
                <div class="article-list-meta">
                  <time datetime={iso(article.data.pubDate)}>{fmt(article.data.pubDate)}</time>
                  <span class="article-category">{article.data.category}</span>
                </div>
                <h2>{article.data.title}</h2>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Cta />
</BaseLayout>

<style>
  .article-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* 白い地に置くカードのため、ごく淡い線を添える */
  .article-list-item {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .article-list-item:hover {
    box-shadow: var(--shadow-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .article-list-item:hover {
      transform: translateY(-2px);
    }
  }

  .article-list-item a {
    display: block;
    height: 100%;
    border-radius: var(--radius-lg);
  }

  .article-list-thumb {
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--line);
  }

  .article-list-body {
    padding: var(--space-5) var(--space-6) var(--space-6);
  }

  .article-list-meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
    font-size: var(--fs-caption);
    color: var(--muted);
  }

  .article-list-item h2 {
    font-size: 18px;
    line-height: 1.6;
  }

  .article-list-item a:hover h2 {
    color: var(--accent-strong);
  }

  @media (max-width: 1080px) {
    .article-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .article-list {
      grid-template-columns: 1fr;
    }
  }
</style>
